# Copy this file to .env and fill in. Never commit .env.
# ------------------------------------------------------------
# FREE TEST SETUP (works with free keys / no keys)
#   Script AI : Gemini free key  (aistudio.google.com → Get API key)
#   Images    : pollinations (no key)  or huggingface (free HF token)
#   Video     : kenburns (free, animated stills) → switch to fal_wan for real AI video
#   Voice     : edge (free, no key, Hindi + English)
# ------------------------------------------------------------

# --- Script AI (step 2 + optional vision QC) ---
# mock = no AI, template storyboard (plumbing test only)
LLM_PROVIDER=openai_compat
LLM_API_KEY=
# Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq (free tier):     LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
# DeepSeek:             LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# OpenAI:               LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini

# --- Keyframe images (step 4) ---
# placeholder | pollinations | cloudflare | huggingface | fal
IMAGE_PROVIDER=pollinations
# tried in order if the main one fails
IMAGE_FALLBACK=cloudflare,huggingface
# free key at enter.pollinations.ai (higher limits, no watermark)
POLLINATIONS_API_KEY=
# Cloudflare Workers AI (free daily quota): dash.cloudflare.com → AI → Workers AI → Use REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Video clips (step 6) ---
# kenburns (free) | fal_wan (paid, Wan 2.2 image-to-video)
VIDEO_PROVIDER=kenburns
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/image-to-video/turbo
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# takes per shot (2 in production; QC picks the best)
VIDEO_TAKES=1

# --- Quality check (step 7): uses the Script AI to look at frames (model must accept images) ---
QC_VISION=false

# --- Voice (step 8) ---
# edge (free) | elevenlabs | silent
TTS_PROVIDER=edge
EDGE_VOICE_HI=hi-IN-SwaraNeural
EDGE_VOICE_EN=en-IN-NeerjaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Dashboard ---
# set to require a password (any username) — recommended if not only on your own PC
DASHBOARD_PASSWORD=
