# Copy this file to .env and fill in. Never commit .env.
# ------------------------------------------------------------
# FREE TEST SETUP (works with free keys / no keys)
#   Script AI : Gemini free key  (aistudio.google.com → Get API key)
#   Images    : pollinations (no key)  or huggingface (free HF token)
#   Video     : kenburns (free, animated stills) → switch to fal_wan for real AI video
#   Voice     : edge (free, no key, Hindi + English)
# ------------------------------------------------------------

# --- Script AI (step 2 + optional vision QC) ---
# mock = no AI, template storyboard (plumbing test only)
LLM_PROVIDER=openai_compat
LLM_API_KEY=
# Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq (free tier):     LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
# DeepSeek:             LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# OpenAI:               LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini

# --- Keyframe images (step 4) ---
# placeholder | pollinations | cloudflare | huggingface | fal
IMAGE_PROVIDER=pollinations
# tried in order if the main one fails
IMAGE_FALLBACK=cloudflare,huggingface
# free key at enter.pollinations.ai (higher limits, no watermark)
POLLINATIONS_API_KEY=
# Cloudflare Workers AI (free daily quota): dash.cloudflare.com → AI → Workers AI → Use REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Video clips (step 6) ---
# kenburns  = free zoom/pan on stills (not real motion)
# hf_space  = FREE real AI motion (Wan 2.2 on a public Hugging Face Space). Needs HF_TOKEN.
#             Free accounts get a few GPU-minutes a day (~1 short video/day); then shots fall back to zoom/pan.
# fal_wan   = paid, fast and reliable real AI motion (FAL_KEY)
VIDEO_PROVIDER=hf_space
HF_VIDEO_SPACES=zerogpu-aoti/wan2-2-fp8da-aoti-faster,r3gm/wan2-2-fp8da-aoti-preview
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/image-to-video/turbo
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# takes per shot (2 in production; QC picks the best)
VIDEO_TAKES=1

# --- Quality check (step 7): uses the Script AI to look at frames (model must accept images) ---
QC_VISION=false

# --- Voice (step 8) ---
# sarvam (recommended for Hindi/Hinglish) | elevenlabs (most expressive, voice cloning) | edge (free, flat) | silent
TTS_PROVIDER=sarvam
# Sarvam Bulbul: key from dashboard.sarvam.ai (new accounts get free credits)
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
# Hindi-friendly speakers to try: ritu, priya, neha, pooja, simran, kavya, shubh, rahul, rohan, amit, aditya
SARVAM_SPEAKER=ritu
SARVAM_PACE=1.05
# 0.01–1.0: higher = more expressive/varied delivery
SARVAM_TEMPERATURE=0.75
# ElevenLabs: eleven_v3 performs emotion tags like [excited] [laughs]. Pick a Hindi voice from their
# Voice Library, or clone your own (tools/clone_voice.py) and put its id here.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
# v3 stability: 0.0 creative · 0.5 natural · 1.0 robust
ELEVENLABS_STABILITY=0.5
EDGE_VOICE_HI=hi-IN-SwaraNeural
EDGE_VOICE_EN=en-IN-NeerjaNeural

# --- Export shapes: 9x16 = Reels/Shorts (vertical), 16x9 = YouTube/Facebook (horizontal) ---
FORMATS=9x16,16x9

# --- Dashboard ---
# set to require a password (any username) — recommended if not only on your own PC
DASHBOARD_PASSWORD=
